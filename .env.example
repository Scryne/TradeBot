# TradeBot ortam değişkenleri. Bu dosyayı `.env` olarak kopyalayıp doldurun. `.env` git'e GİRMEZ.
# Sırlar yalnız host'ta durur; log, pano ve git'e yazılmaz.

# PostgreSQL parolası (uzun, rastgele): python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# host | gelistirme
TRADEBOT_ORTAM=host
TRADEBOT_LOG_SEVIYESI=INFO

# Jev (TypeSafe) — https://typesafe.ai
TYPESAFE_API_KEY=
# Belirsiz durumda yükseltme modeli — https://build.nvidia.com (Faz 6)
NVIDIA_API_KEY=
# Bildirim botu (Faz 9)
TRADEBOT_TELEGRAM_TOKEN=
